# ==========================================
# TLAB MONITOR EXAMPLE CONFIGURATION
# ==========================================

# 0. System Configuration
TZ=Asia/Ho_Chi_Minh

# 1. Webhook & Domain Information
N8N_LOCAL_IP=192.168.x.x
N8N_PUBLIC_DOMAIN=https://n8n.yourdomain.com
NTFY_PUBLIC_DOMAIN=https://ntfy.yourdomain.com

# 2. Security Keys & APIs
NTFY_BASE64_CREDENTIALS=your_base64_string_here
OPENROUTER_API_KEY=sk-or-v1-xxxxxx
PROXMOX_API_TOKEN=root@pam!token=xxxx-xxxx

# 3. Database Credentials (PostgreSQL)
DB_USER=tlab_user
DB_PASSWORD=your_secure_password
DB_NAME=tlab_db